SECRET_KEY=replace-me-with-a-strong-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use the default local SQLite database.
# Optional PostgreSQL DSN: postgres://postgres:postgres@localhost:5432/civic_governance

CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@civic.local
# Set these for SMTP delivery outside local development.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

MEDIA_ROOT=./media
MEDIA_URL=/media/

# --- AI provider configuration ---
# AI_PROVIDER: gemini | mock | none
#   gemini -> uses the Google Gemini API (requires GEMINI_API_KEY)
#   mock   -> offline keyword-based fallback, no network calls (safe for local dev/tests)
#   none   -> AI features disabled
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_REQUEST_TIMEOUT=20
AI_MAX_RETRIES=2
# Run AI analysis automatically when a complaint is submitted.
AI_AUTO_ANALYZE=True
# Cosine similarity above which two complaints are flagged as possible duplicates.
AI_SIMILARITY_THRESHOLD=0.42
# Predictions below this confidence are flagged for mandatory human review.
AI_LOW_CONFIDENCE_THRESHOLD=0.55
